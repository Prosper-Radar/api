DATABASE_URL=postgresql://user:password@localhost:5432/dealscout
SECRET_KEY=your-secret-key-min-32-chars
DEBUG=false

# Miami-Dade PA — not required, GIS endpoint is public
MIAMI_DADE_API_KEY=

# Census ACS — free key: https://api.census.gov/signup.html
# Without a key: population_growth metric is skipped (weights redistributed)
CENSUS_API_KEY=

# FDOT AADT — no key needed (public GIS portal)
# Without geometry data: traffic metric is skipped (weights redistributed)

ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Mapbox — aerial imagery in deal memo PDF (same token as webapp)
MAPBOX_TOKEN=pk.xxx

# Email alerts — Tier A deals
ALERT_EMAIL_TO=you@example.com,partner@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com
APP_URL=https://app.prosperradar.com

REDIS_URL=redis://localhost:6379/0
